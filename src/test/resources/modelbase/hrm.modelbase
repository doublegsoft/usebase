@module(name='hrm')
@persistence(name='tn_hrm_hol')
@name(label='节假日', singular='holiday', plural='holidays')
holiday<

  @persistence(name='id')
  @name(label='物理主键')
  id!!: long,

  @persistence(name='nm')
  @name(label='节假日名称')
  name: string(100), // realText(30) 通常对应短文本

  @persistence(name='descr')
  @name(label='描述')
  description: string(500),

  @persistence(name='stdt')
  @name(label='开始时间')
  start_date: datetime,

  @persistence(name='nddt')
  @name(label='结束时间')
  end_date: datetime,

  @persistence(name='isannl')
  @name(label='是否每年重复')
  is_annual: boolean,

  @persistence(name='clr')
  @name(label='日历显示颜色')
  color: enum[
    PRIMARY:主要,
    SECONDARY:次要,
    SUCCESS:成功,
    WARNING:警告,
    DANGER:危险,
    INFO:信息
  ]
>

@module(name='hrm')
@persistence(name='tn_hrm_emp')
@name(label='员工', singular='employee', plural='employees')
employee<

  @persistence(name='empid')
  @name(label='员工标识')
  id!!: &person(id),

  @persistence(name='empnm')
  @name(label='姓名')
  name: string(128),

  @persistence(name='natid')
  @name(label='身份证号码')
  national_id: string(128),

  @persistence(name='empno')
  @name(label='工号')
  employee_no: string(64),

  @persistence(name='gendr')
  @name(label='性别')
  gender: enum[male:男性, female:女性, other:其他],

  @persistence(name='birthdt')
  @name(label='出生日期')
  birth_date: date,

  @persistence(name='deptid')
  @name(label='所属部门')
  department: &department(id),

  @persistence(name='desgid')
  @name(label='当前职位')
  designation: &designation(id),

  @persistence(name='phoneno')
  @name(label='联系电话')
  phone_number: string(32),

  @persistence(name='email')
  @name(label='电子邮件')
  email: string(128),

  @persistence(name='addr')
  @name(label='地址')
  address: text,

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='crttm')
  @name(label='入职时间')
  created_time = now: datetime,

  @persistence(name='lmt')
  @name(label='最后更新时间')
  last_modified_time: now
>

@module(name='hrm')
@persistence(name='tn_hrm_dept')
@name(label='部门')
@treelike
department<

  @persistence(name='deptid')
  @name(label='部门标识')
  id!!: long,

  @persistence(name='deptnm')
  @name(label='部门名称')
  name: string(128),

  @persistence(name='pardepid')
  @name(label='上级部门')
  parent: &department(id),

  @persistence(name='fullpath')
  @name(label='完整路径')
  fullpath: &department(id),

  @persistence(name='mgr')
  @name(label='部门负责人')
  manager: &employee(id),

  @persistence(name='descr')
  @name(label='描述')
  description: text,

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='ordpos')
  @name(label='顺序位置')
  ordinal_position: integer,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime,

  @persistence(name='lmt')
  @name(label='最后更新时间')
  last_modified_time: now
>

@module(name='hrm')
@persistence(name='tn_hrm_desg')
@name(label='职位', singular='designation', plural='designations')
designation<

  @persistence(name='desgid')
  @name(label='职位标识')
  id!!: long,

  @persistence(name='desgnm')
  @name(label='职位名称')
  name: string(128),

  @persistence(name='deptid')
  @name(label='所属部门')
  department: &department(id),

  @persistence(name='descr')
  @name(label='职位描述')
  description: text,

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime,

  @persistence(name='lmt')
  @name(label='最后更新时间')
  last_modified_time: now
>

@module(name='hrm')
@persistence(name='tn_hrm_emp_job')
@name(label='任职记录', singular='employment', plural='employments')
employment<

  @persistence(name='empjobid')
  @name(label='任职记录标识')
  id!!: long,

  @persistence(name='empid')
  @name(label='员工')
  employee: &employee(id),

  @persistence(name='desgid')
  @name(label='职位')
  designation: &designation(id),

  @persistence(name='deptid')
  @name(label='部门')
  department: &department(id),

  @persistence(name='stt')
  @name(label='开始日期')
  start_date: date,

  @persistence(name='enddt')
  @name(label='结束日期')
  end_date: date,

  @persistence(name='sta')
  @name(label='状态')
  status: string(1),

  @persistence(name='descr')
  @name(label='备注')
  description: string(1000)
>

@module(name='hrm')
@persistence(name='tn_hrm_att')
@name(label='考勤记录', singular='attendance', plural='attendances')
attendance<

  @persistence(name='attid')
  @name(label='考勤标识')
  id!!: long,

  @persistence(name='empid')
  @name(label='员工')
  employee: &employee(id),

  @persistence(name='workdt')
  @name(label='日期')
  work_date: date,

  @persistence(name='checkin')
  @name(label='签到时间')
  check_in_time: datetime,

  @persistence(name='checkout')
  @name(label='签退时间')
  check_out_time: datetime,

  @persistence(name='stat')
  @name(label='出勤状态')
  attendance_status: enum[present:出勤, absent:缺勤, late:迟到, on_leave:早退],

  @persistence(name='descr')
  @name(label='备注')
  description: text
>

@module(name='hrm')
@persistence(name='tn_hrm_sal')
@name(label='薪资记录', singular='salary', plural='salaries')
salary<

  @persistence(name='salid')
  @name(label='薪资标识')
  id!!: long,

  @persistence(name='empid')
  @name(label='员工')
  employee: &employee(id),

  @persistence(name='month')
  @name(label='薪资月份')
  salary_month: string(7),

  @persistence(name='baseamt')
  @name(label='基本工资')
  base_amount: number(10,2),

  @persistence(name='bonus')
  @name(label='奖金')
  bonus: number(10,2),

  @persistence(name='deduction')
  @name(label='扣款')
  deduction: number(10,2),

  @persistence(name='netamt')
  @name(label='实发工资')
  net_amount: number(10,2),

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime
>

@persistence(name='tn_hrm_empsal')
@name(label='员工薪资', singular='employee_salary', plural='employee_salaries')
@zipper
employee_salary<

  @persistence(name='empsalid')
  @name(label='物理主键')
  id!!: long,

  @persistence(name='empid')
  @name(label='所属员工')
  employee: &employee(id),

  @persistence(name='amt')
  @name(label='基本工资')
  amount: number(15, 2),

  @persistence(name='ccy')
  @name(label='币种')
  currency: string(3),

  @persistence(name='effstdt')
  @name(label='生效开始日期')
  effective_start_date: date,

  @persistence(name='effenddt')
  @name(label='生效结束日期')
  effective_end_date: date,

  @persistence(name='iscur')
  @name(label='是否当前薪资')
  is_current: boolean,

  @persistence(name='chgrsn')
  @name(label='调薪原因')
  change_reason: enum[
    NH:NEW_HIRE,
    PR:PROMOTION,
    AN:ANNUAL,
    AD:ADJUSTMENT
  ],

  @persistence(name='credt')
  @name(label='记录创建时间')
  created_time = now: datetime
>

@persistence(name='tn_hrm_jobhist')
@name(label='员工岗位历史', singular='job_history', plural='job_histories')
@zipper
job_history <

  @persistence(name='id')
  @name(label='物理主键')
  id!!: long,

  @persistence(name='empid')
  @name(label='所属员工')
  employee: &employee(id),

  @persistence(name='deptid')
  @name(label='所在部门')
  department: &department(id),

  @persistence(name='desgid')
  @name(label='担任职位')
  designation: &designation(id),

  @persistence(name='effstdt')
  @name(label='生效开始日期')
  effective_start_date: date,

  @persistence(name='effenddt')
  @name(label='生效结束日期')
  effective_end_date: date,

  @persistence(name='iscur')
  @name(label='是否当前岗位')
  is_current: boolean,

  @persistence(name='chgtyp') // change_type -> chgtyp
  @name(label='变动类型')
  change_type: enum[
    HIRE:入职,
    TRANSFER:平级调动,
    PROMOTION:晋升,
    DEMOTION:降职,
    TERMINATION:离职
  ],

  @persistence(name='chgrsn') // change_reason -> chgrsn
  @name(label='变动原因描述')
  change_reason: string(500), // HR 填写的具体原因

  @persistence(name='mgrid') // manager_id -> mgrid
  @name(label='汇报对象(主管)')
  manager: &employee(id), // 调岗往往伴随着换主管

  @persistence(name='creby')
  @name(label='操作人')
  created_by: long, // 记录是哪个 HR 做的调整

  @persistence(name='credt')
  @name(label='记录创建时间')
  created_time = now: datetime
>