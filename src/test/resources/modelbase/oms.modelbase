@persistence(name='tn_oms_org', text='机构信息表', revision='tr_oms_org')
@name(label='机构信息', singular='organization', plural='organizations')
@entity
organization<

  @persistence(name='orgid', query='=')
  @name(label='机构标识')
  id!!: uuid,

  @persistence(name='parorgid', query='=')
  @name(label='父机构标识')
  parent: &organization(id),

  @persistence(name='orgnm', query='%%')
  @name(label='机构名称')
  name!: name(organization),

  @persistence(name='lg')
  @name(label='标志')
  logo: text,

  @persistence(name='ownp', query='=')
  @name(label='所有制形式')
  ownership: string(20),

  @persistence(name='regnr')
  @name(label='工商注册号')
  registered_number: string(20),

  @persistence(name='regdt')
  @name(label='注册时间')
  registered_date: date,

  @persistence(name='ph')
  @name(label='电话')
  phone: string(30),

  @persistence(name='pstcd')
  @name(label='邮编')
  postalcode: string(6),

  @persistence(name='legrep')
  @name(label='法定代表人')
  legal_representative: name(person),

  @persistence(name='regoff')
  @name(label='注册地址')
  registered_office: address,

  @persistence(name='regcap')
  @name(label='注册资金')
  registered_capital: number(20),

  @persistence(name='deregdt')
  @name(label='注销时间')
  deregistered_date: date,

  @persistence(name='fddt')
  @name(label='成立日期')
  founded_date: date,

  @persistence(name='provcd', query='=')
  @name(label='所在省份')
  province: &chinese_district(code),

  @persistence(name='cycd', query='=')
  @name(label='所在城市')
  city: &chinese_district(code),

  @persistence(name='cntycd', query='=')
  @name(label='所在区县')
  county: &chinese_district(code),

  @persistence(name='twncd')
  @name(label='所在乡镇')
  town: &chinese_district(code),

  @persistence(name='adr')
  @name(label='地址')
  address: string(1000),

  @persistence(name='site')
  @name(label='公司网站')
  website: string(400),

  @persistence(name='nt')
  @name(label='备注')
  note: string(2000),

  @persistence(name='sta')
  @name(label='有效性')
  state: state,

  @persistence(name='lmt')
  @name(label='最近修改时间')
  last_modified_time: now,

  @comment(text='下属机构')
  children: &organization(id)[]

>

@persistence(name='tn_oms_dpt', text='部门信息表')
@name(label='部门信息', singular='department', plural='departments')
@entity
@widgets(
  form='parent+name',
  table='(name+parent)|部门',
  query='name'
)
department<

  @persistence(name='dptid')
  @name(label='部门标识')
  @query(operator='=')
  id!!: uuid,

  @persistence(name='pardptid', text='部门标识', query='=')
  @name(label='上级部门')
  parent: &department(id),

  @persistence(name='orgid', query='=')
  @name(label='机构标识')
  organization: &organization(id),

  @persistence(name='dptnm', query='')
  @name(label='部门名称')
  @query(operator='%%')
  name!: name(department),

  @persistence(name='fddt')
  @name(label='成立日期')
  founded_date: date,

  @persistence(name='ordpos')
  @name(label='排序位置')
  ordinal_position: int,

  @persistence(name='nt')
  @name(label='备注')
  note: string(2000),

  @persistence(name='sta', query='=')
  @name(label='有效性')
  state: state,

  @persistence(name='lmt')
  @name(label='最近修改时间')
  @system
  last_modified_time: now,

  @name(label='下属部门')
  children: &department(id)[],

  // @persistence(conjunction='department_employee')
  @name(label='下属员工', singular='employee')
  employees: &department_employee(department)[]
>

@persistence(name='tn_oms_empl', text='员工信息表')
@name(label='员工信息', singular='employee', plural='employees')
@entity
@widgets(
  form='(name+type)+(position+hire_date)+note',
  table='name+(position+department)|部门+state+(@activate+@deactivate)|操作',
  query='name+type'
)
employee<

  @persistence(name='emplid', query='=')
  @name(label='员工标识')
  @extension(role='save')
  id!!: &person(id),

  @persistence(name='emplnr', query='=')
  @name(label='工号')
  employee_number: code(64),

  @persistence(name='emplnm', query='%%')
  @name(label='员工姓名')
  name: name(person),

  @persistence(name='bdt')
  @name(label='出生日期')
  birthdate: date,

  @persistence(name='mob')
  @name(label='手机号')
  mobile: string(16),

  @persistence(name='eml')
  @name(label='邮箱')
  email: string(100),

  @persistence(name='empltyp', query='[]employeeTypes')
  @name(label='类型')
  type: enum[R: 正式员工, P: 试用期员工, T: 实习员工, L: 离职员工],

  @persistence(name='emplposid', query='=')
  @name(label='职位')
  position: &employee_position(id),

  @persistence(name='dptid', query='=')
  @name(label='入职部门')
  department: &department(id),

  @persistence(name='orgid', query='=')
  @name(label='所属机构')
  organization: &organization(id),

  @persistence(name='sklvl', query='=')
  @name(label='级别')
  skill_level: string(40),

  @persistence(name='hrdt', query='<>')
  @name(label='入职日期')
  hire_date: date,

  @persistence(name='frdt', query='<>')
  @name(label='离职日期')
  fired_date: date,

  @persistence(name='frtyp', text='离职方式')
  fired_type: enum[L: 离职, F: 开除, M: 失踪],

  @persistence(name='ordpos', text='排序位置')
  ordinal_position = '1': int,

  @persistence(name='nt')
  @name(label='备注')
  note: string(2000),

  @persistence(name='modid', text='修改者标识')
  @reference(value='id', name='modifier')
  modifier_id: string(64),

  @persistence(name='modtyp', text='修改者类型')
  @reference(value='type', name='modifier')
  modifier_type: string(64),

  @persistence(name='sta', text='系统状态')
  state: state,

  @persistence(name='lmt', text='最近修改时间')
  last_modified_time: now,

  @name(label='所属部门', singular='department')
  departments: &department_employee(department)[]
>

@persistence(name='tn_oms_emplpos', text='职位信息表')
@name(label='职位信息', singular='employee_position', plural='employee_positions')
@entity
employee_position<

  @persistence(name='emplposid', query='=', text='职位标识')
  id!!: uuid,

  @persistence(name='emplposnm', query='=', text='职位名称')
  @name(label='职位名称')
  name!+: name,

  @persistence(name='lvl')
  @name(label='级别')
  level: string(16),

  @persistence(name='ordpos')
  @name(label='顺序号')
  ordinal_position+: integer

>

@persistence(name='tv_oms_dptempl', text='部门所属员工信息表')
@name(label='部门所属员工信息', singular='department_employee', plural='department_employees')
@value
department_employee<

  @persistence(name='dptid', query='=', text='部门标识')
  department!!: &department(id),

  @persistence(name='emplid', query='=', text='员工标识')
  employee!!: &employee(id),

  @persistence(name='servdt', query='<>')
  @name(label='任职日期')
  service_date!!: date,

  @persistence(name='pos', query='=')
  @name(label='职位')
  position!: &employee_position(id),

  @persistence(name='ldr')
  @name(label='领导标志')
  leader!: bool,

  @persistence(name='sta', query='=')
  @name(label='有效性')
  state = 'A': state
>
