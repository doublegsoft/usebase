@module(name='iam', text='identity and access management')
@persistence(name='tn_iam_usr')
@name(label='用户', plural='users')
user<

  @persistence(name='usrid')
  @name(label='用户标识')
  id!!: long,

  @persistence(name='usrnm')
  @name(label='用户名')
  username: string(100),

  @persistence(name='encrpwd')
  @name(label='加密后密码')
  encrypted_password: string(255),

  @persistence(name='em')
  @name(label='邮箱')
  email: string(255),

  @persistence(name='sts')
  @name(label='状态')
  status: enum[AC:激活, LK:锁定, DS:禁用],

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime,

  @persistence(name='lmt')
  @name(label='最后更新时间')
  last_modified_time: now,

  @name(label='用户角色', singular='user_role')
  user_roles: &user_role(user)[]
>

@persistence(name='tn_iam_rl')
@name(label='角色', plural='roles')
role<

  @persistence(name='rlid')
  @name(label='角色标识')
  id!!: long,

  @persistence(name='rlnm')
  @name(label='角色名称')
  name: string(100),

  @persistence(name='descr')
  @name(label='描述')
  description: text,

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime,

  @persistence(name='lmt')
  @name(label='最后更新时间')
  last_modified_time: now,

  @name(label='角色权限', singular='permission')
  @conjunction(object='role_permission')
  permissions: &permission(id)[]
>

@persistence(name='tn_iam_perm')
@name(label='权限', plural='permissions')
permission<

  @persistence(name='permid')
  @name(label='权限标识')
  id!!: long,

  @persistence(name='restyp')
  @name(label='资源类型')
  @reference(name='resource', value='type')
  resource_type: string(300),

  @persistence(name='resid')
  @name(label='资源标识')
  @reference(name='resource', value='id')
  resource_id: string(300),

  @persistence(name='act')
  @name(label='操作')
  action: enum[RD:读取, WR:写入, UP:更新, DL:删除],

  @persistence(name='descr')
  @name(label='描述')
  description: text,

  @persistence(name='sta')
  @name(label='状态')
  state: state,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime
>

@persistence(name='tn_iam_usrrl')
@name(label='用户角色', plural='user_roles')
user_role<

  @persistence(name='usrid')
  @name(label='用户')
  user!!: &user(id),

  @persistence(name='rlid')
  @name(label='角色')
  role!!: &role(id),

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime
>

@value
@persistence(name='tn_iam_role_permission')
@name(label='角色权限', plural='role_permissions')
role_permission<

  @persistence(name='roleid')
  @name(label='角色')
  role!!: &role(id),

  @persistence(name='permid')
  @name(label='权限')
  permission!!: &permission(id),

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time = now: datetime
>