@module(name='bpe', text='business policy engine')

@persistence(name='tn_bpe_bizpol')
@name(label='流程定义', plural='business_policies')
business_policy<

  @name(label='标识')
  @persistence(name='bizpoldefid')
  id!!: long,

  @name(label='用户代码')
  @persistence(name='bizpoldefcd')
  code!+: string(30),

  @name(label='流程名称')
  @persistence(name='bizpoldefnm')
  name!+: string(100),

  @name(label='版本号')
  @persistence(name='ver')
  version+: integer,

  @name(label='生效开始日期')
  @persistence(name='effsttm')
  effective_start_time: datetime,

  @name(label='生效开始日期')
  @persistence(name='effndtm')
  effective_end_time: datetime,

  @name(label='备注')
  @persistence(name='nt')
  note: string(2000),

  @name(label='创建者标识')
  @persistence(name='crtrid')
  creator_id: long,

  @name(label='创建时间')
  @persistence(name='crttm')
  created_time = now: datetime,

  @name(label='修改者标识')
  @persistence(name='modid')
  modifier_id: long,

  @name(label='最后修改时间')
  @persistence(name='lmt')
  last_modified_time: now,

  @name(label='节点列表', singular='node')
  nodes: &business_policy_node(id)[]
>

@persistence(name='tn_bpe_bizpolcond')
@name(label='策略条件')
@entity
business_policy_condition<

  @name(label='标识')
  @persistence(name='bizpolcondid')
  id!!: long,

  @name(label='策略')
  @persistence(name='bizpolid')
  business_policy: &business_policy(id),

  @name(label='字段')
  @persistence(name='fld')
  field: string(64),

  @name(label='操作符')
  @persistence(name='opr')
  operator: string(16),

  @name(label='值')
  @persistence(name='val')
  value: string(256),

  @name(label='逻辑关系')
  @persistence(name='lgc')
  logic: string(8),          // AND / OR

  @name(label='顺序')
  @persistence(name='ordpos')
  ordinal_position: integer
>

@persistence(name='tn_bpe_bizpolact')
@name(label='策略动作')
business_policy_action<

  @name(label='标识')
  @persistence(name='bizpolactid')
  id!!: long,

  @name(label='策略')
  @persistence(name='bizpolid')
  business_policy: &business_policy(id),

  @name(label='动作类型')
  @persistence(name='bizpolacttyp')
  type: string(32),   // ALLOW / DENY / FILTER / MASK / ROUTE / COMPUTE

  @name(label='目标字段')
  @persistence(name='tgt')
  target: string(64),

  @name(label='表达式')
  @persistence(name='expr')
  expression: string(1000),  // SQL / DSL

  @name(label='顺序')
  @persistence(name='ordpos')
  ordinal_position: integer
>
