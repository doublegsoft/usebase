@persistence(name='cfg_rate_code')
@name(label='费率代码', plural='cfg_rate_codes')
cfg_rate_code<

  @persistence(name='rate_code')
  @name(label='费率代码')
  id!!: string(50),

  @persistence(name='rate_sel_mode_ind')
  @name(label='费率选择模式')
  rate_sel_mode_ind: enum[S:按开始日期, E:按结束日期, P:按比例分摊],

  @persistence(name='svc_cls_code')
  @name(label='服务类别')
  svc_cls_code: string(100),

  @persistence(name='allow_est_sw')
  @name(label='允许预估')
  allow_est_sw: enum[Y:是, N:否],

  @persistence(name='rate_code_desc')
  @name(label='描述(英文)')
  rate_code_desc: string(500),

  @persistence(name='rate_code_desc_tc')
  @name(label='描述(繁体中文)')
  rate_code_desc_tc: string(500),

  @persistence(name='rate_code_desc_sc')
  @name(label='描述(简体中文)')
  rate_code_desc_sc: string(500),

  @persistence(name='obs_sw')
  @name(label='作废')
  obs_sw: enum[Y:是, N:否],

  @persistence(name='allow_backdate_sw')
  @name(label='允许回溯')
  allow_backdate_sw: enum[Y:是, N:否]
>

@persistence(name='cfg_svc_type_rate_code')
@name(label='服务类型费率关联', plural='cfg_svc_type_rate_codes')
cfg_svc_type_rate_code<

  @persistence(name='svc_type_code')
