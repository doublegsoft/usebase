  @persistence(name='auto_pay_stop_amt')
  @name(label='停止自动付款的金额')
  auto_pay_stop_amt: string,

  @persistence(name='auto_pay_stop_created_date')
  @name(label='停止自动付款的创建日期')
  auto_pay_stop_created_date: string,

  @persistence(name='created_by')
  @name(label='')
  created_by: string(8),

  @persistence(name='modified_by')
  @name(label='')
  modified_by: string(8),

  @persistence(name='modified_date')
  @name(label='')
  modified_date: string,

  @persistence(name='timestamp')
  @name(label='')
  timestamp: string,

  @persistence(name='account_days')
  @name(label='账单天数，Total No. Of Days')
  account_days: string(255)
>

@persistence(name='bitem')
@name(label='账单信息明细表')
@value
bitem<

  @persistence(name='bitem_id')
  @name(label='主键')
  bitem_id!!: string,

  @persistence(name='bill_cyc_code')
  @name(label='账单周期')
  bill_cyc_code: string(4),

  @persistence(name='win_start_date')
  @name(label='账单周期的开始时间（账单周期会在开始时间后开账）')
  win_start_date: string,

  @persistence(name='canc_rsn_code')
  @name(label='取消原因编码，Bitem被Cancel时回填')
  canc_rsn_code: string(4),

  @persistence(name='canc_bitem_id')
  @name(label='关联Rebill时旧的、需要取消的BitemID，外键')
  canc_bitem_id: string,

  @persistence(name='svc_id')
  @name(label='')
  svc_id: string(10),

  @persistence(name='bill_id')
  @name(label='')
  bill: &bill(bill_id),

  @persistence(name='start_date')
  @name(label='计费开始时间')
  start_date: string,

  @persistence(name='end_date')
  @name(label='计费结束时间')
  end_date: string,

  @persistence(name='est_sw')
  @name(label='预估开关，取决于开账计划的日期及Account是否允许预估')
  est_sw: string,

  @persistence(name='closing_bitem_sw')
  @name(label='当Bitem的EndDate>=SD的EndDate时为Y，代表是该SD最后一次账单')
  closing_bitem_sw: string,

  @persistence(name='bill_qty_ovrd_sw')
  @name(label='是否需要加仑转换，生成Bill Qty 数据')
  bill_qty_ovrd_sw: string,

  @persistence(name='premise_id')
  @name(label='关联Premise，外键ID')
  premise_id: string,

  @persistence(name='bitem_sts_ind')
  @name(label='计费项状态')
  bitem_sts_ind: string,

  @persistence(name='created_date')
  @name(label='创建时间')
  created_date: string,

  @persistence(name='sts_chg_date')
  @name(label='')
  sts_chg_date: string,

  @persistence(name='rebill_bitem_id')
  @name(label='重新计费的billing Item ID')
  rebill_bitem_id: string,

  @persistence(name='created_by')
  @name(label='创建人')
  created_by: string(8),

  @persistence(name='modified_by')
  @name(label='修改人')
  modified_by: string(8),

  @persistence(name='modified_date')
  @name(label='修改时间')
  modified_date: string,

  @persistence(name='timestamp')
  @name(label='时间戳')
  timestamp: string,

  @persistence(name='quote_id')
  @name(label='关联表Quote，外键ID')
  quote_id: string,

  @persistence(name='quote_master_id')
  @name(label='关联表Quote_Master，外键ID')
  quote_master_id: string,

  @persistence(name='account_days')
  @name(label='天数(新增字段)')
  account_days: string,

  @persistence(name='seq')
  @name(label='序号(新增字段)(不为空)')
  seq!!: string,

  @persistence(name='start_meter_read_id')
  @name(label='起码抄表ID(新增字段)(不为空)')
  start_meter_read_id: string,

  @persistence(name='end_meter_read_id')
  @name(label='止码抄表ID(新增字段)(不为空)')
  end_meter_read_id: string,

  @persistence(name='start_reading')
  @name(label='本期开始读数(新增字段)(不为空)')
  start_reading: string,

  @persistence(name='end_reading')
  @name(label='本期读数(新增字段)(不为空)')
  end_reading: string,

  @persistence(name='final_qty')
  @name(label='最终水量(新增字段)(不为空)')
  final_qty: string,

  @persistence(name='chg_item_id')
  @name(label='杂项费用ID(新增字段)')
  chg_item_id: string,

  @persistence(name='calc_amt')
  @name(label='计费金额(新增字段)(不为空)')
  calc_amt: string,

  @persistence(name='rate_id')
  @name(label='价格ID(新增字段)')
  rate_id: string,

  @persistence(name='calc_start_date')
  @name(label='calc的开始时间(新增字段)')
  calc_start_date: string,

  @persistence(name='calc_end_date')
  @name(label='calc的结束时间(新增字段)')
  calc_end_date: string,

  @persistence(name='rate_code')
  @name(label='Rate Code(新增字段)')
  rate_code: string(8),

  @persistence(name='eff_date')
  @name(label='Effective DateRate 的生效日期(新增字段)')
  eff_date: string,

  @persistence(name='desc_on_bill')
  @name(label='Description On Bill(新增字段)')
  desc_on_bill: string(80)
>

