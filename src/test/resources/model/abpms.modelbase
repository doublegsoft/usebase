@persistence(name='account')
@name(label='用户信息主表')
@entity
account<

  @persistence(name='account_id')
  @name(label='帐户Id')
  account_id!!: string,

  @persistence(name='bill_cyc_code')
  @name(label='账单周期Code')
  bill_cyc_code: string(4),

  @persistence(name='setup_date')
  @name(label='设置日期')
  setup_date: string,

  @persistence(name='allow_est_sw')
  @name(label='是否允许估抄')
  allow_est_sw: string,

  @persistence(name='comments')
  @name(label='备注')
  comments: string(250),

  @persistence(name='bill_after_date')
  @name(label='开账在日期后')
  bill_after_date: string,

  @persistence(name='bill_after_date_updated_by')
  @name(label='BILL_AFTER_DATE字段的更新人')
  bill_after_date_updated_by: string(8),

  @persistence(name='lock_bill_cyc_sw')
  @name(label='锁定帐单周期开关')
  lock_bill_cyc_sw: string,

  @persistence(name='mail_premise_id')
  @name(label='邮寄房屋Id')
  mail_premise_id: string,

  @persistence(name='lock_premise_id_sw')
  @name(label='锁定房屋Id开关')
  lock_premise_id_sw: string,

  @persistence(name='cr_rev_date')
  @name(label='信用审查日期')
  cr_rev_date: string,

  @persistence(name='postp_cr_rev_date')
  @name(label='推迟信用审查日期')
  postp_cr_rev_date: string,

  @persistence(name='rev_active_collection_sw')
  @name(label='查看活动收集开关')
  rev_active_collection_sw: string,

  @persistence(name='cust_cls_code')
  @name(label='客户类别Code')
  cust_cls_code: string(8),

  @persistence(name='bill_print_intcp_by')
  @name(label='票据打印拦截人')
  bill_print_intcp_by: string(8),

  @persistence(name='no_deposit_rev_sw')
  @name(label='数字存款审核开关')
  no_deposit_rev_sw: string,

  @persistence(name='email_addr')
  @name(label='电子邮件地址')
  email_addr: string(70),

  @persistence(name='bill_addr_src_ind')
  @name(label='帐单地址来源指示器')
  bill_addr_src_ind: string(4),

  @persistence(name='person_id')
  @name(label='人员Id')
  person_id: string,

  @persistence(name='bill_route_type_code')
  @name(label='票据路线类型Code')
  bill_route_type_code: string(8),

  @persistence(name='name_prefx_suffx')
  @name(label='名称前缀后缀')
  name_prefx_suffx: string(50),

  @persistence(name='prefx_suffx_ind')
  @name(label='前缀后缀指示符')
  prefx_suffx_ind: string,

  @persistence(name='created_by')
  @name(label='创建人')
  created_by: string(8),

  @persistence(name='created_date')
  @name(label='创建日期')
  created_date: string,

  @persistence(name='modified_by')
  @name(label='修改人')
  modified_by: string(8),

  @persistence(name='modified_date')
  @name(label='修改日期')
  modified_date: string,

  @persistence(name='timestamp')
  @name(label='时间戳')
  timestamp: string,

  @persistence(name='bus_activity_desc')
  @name(label='业务活动描述')
  bus_activity_desc: string(250),

  @persistence(name='addr_line1')
  @name(label='地址行1')
  addr_line1: string(64),

  @persistence(name='addr_line2')
  @name(label='地址行2')
  addr_line2: string(64),

  @persistence(name='addr_line3')
  @name(label='地址行3')
  addr_line3: string(64),

  @persistence(name='addr_line4')
  @name(label='地址行4')
  addr_line4: string(64),

  @persistence(name='force_deposit_rev_sw')
  @name(label='强制存款审查开关')
  force_deposit_rev_sw: string,

  @persistence(name='used_ind')
  @name(label='用途')
  used_ind: string(4)
>

@persistence(name='bill')
