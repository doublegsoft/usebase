  @persistence(name='allow_reopen_sw')
  @name(label='允许Reopen开关')
  allow_reopen_sw: string,

  @persistence(name='next_cr_rev_date')
  @name(label='下期信用审查日期')
  next_cr_rev_date: string,

  @persistence(name='auto_pay_created_date')
  @name(label='自动付款创建日期')
  auto_pay_created_date: string,

  @persistence(name='auto_pay_amt')
  @name(label='自动付款金额')
  auto_pay_amt: string,

  @persistence(name='auto_pay_stop_userid')
  @name(label='停止自动付款的人员ID')
