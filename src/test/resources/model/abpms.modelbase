  due_date: string,

  @persistence(name='created_date')
  @name(label='创建日期')
  created_date: string,

  @persistence(name='comp_date')
  @name(label='完成日期')
  comp_date: string,

  @persistence(name='late_payment_chg_sw')
  @name(label='附加费开关')
