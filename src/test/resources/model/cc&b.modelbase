@module(name='ccb')

// ==========================================
// 核心实体：客户 (Customer / Person)
// ==========================================
@persistence(name='ci_person')
@name(label='客户', singular='customer', plural='customers')
customer<

  @persistence(name='person_id')
  @name(label='客户标识')
  id!!: string(30),

  @persistence(name='person_name')
  @name(label='客户名称')
  name: string(200),

  @persistence(name='person_type_flg')
  @name(label='客户类型')
  type: enum[IND:个人, ORG:企业],

  @persistence(name='cre_dttm')
  @name(label='创建时间')
  created_time = now: datetime
>

// ==========================================
// 核心实体：账户 (Account)
// ==========================================
@persistence(name='ci_acct')
@name(label='账户', singular='account', plural='accounts')
account<

  @persistence(name='acct_id')
  @name(label='账户标识')
  id!!: string(30),

  @persistence(name='acct_nbr')
  @name(label='账户号')
  account_number: string(30),

  @persistence(name='cis_division')
  @name(label='事业部')
  division: string(10),

  @persistence(name='setup_dt')
  @name(label='开户日期')
  setup_date: date,

  @persistence(name='cre_dttm')
  created_time = now: datetime,

  @name(label='客户')
  customer: &customer(id)
>

@persistence(name='ci_acct_char')
@name(label='账户属性', singular='account_attribute', plural='account_attributes')
account_attribute<

  // 【主键1】 + 【外键】：既是由于 account 的外键，也是本表的联合主键之一
  @persistence(name='acct_id')
  @name(label='账户')
  account!!: &account(id),

  // 【主键2】：属性类型
  @persistence(name='char_type_cd')
  @name(label='属性类型')
  type!!: string(8),

  @persistence(name='eff_dt')
  @name(label='生效日期')
  effective_date: date,

  @persistence(name='char_val')
  @name(label='属性值')
  value: string(50),

  @persistence(name='adhoc_char_val')
  @name(label='自定义值')
  adhoc_value: string(254)
>

// ==========================================
// 新增实体：接入点 (Premise / Property)
// ==========================================
@persistence(name='ci_prem')
@name(label='接入点', singular='premise', plural='premises')
premise<

  @persistence(name='prem_id')
  @name(label='接入点标识')
  id!!: string(10),

  @persistence(name='prem_type_cd')
  @name(label='接入点类型')
  type: string(8),

  @persistence(name='address1')
  @name(label='地址行1')
  address1: string(254),

  @persistence(name='city')
  @name(label='城市')
  city: string(96),

  @persistence(name='postal')
  @name(label='邮政编码')
  postal: string(12),

  @persistence(name='geo_type_cd')
  @name(label='地理类型')
  geo_type: string(8),

  @persistence(name='geo_val')
  @name(label='地理坐标值')
  geo_value: string(50),

  // 反向引用：该地址下的历史服务协议
  @name(label='服务协议')
  service_agreements: &service_agreement(premise)[]
>

// ==========================================
// 核心实体：服务协议 (Service Agreement)
// ==========================================
@persistence(name='ci_sa')
@name(label='服务协议', singular='service_agreement', plural='service_agreements')
service_agreement<

  @persistence(name='sa_id')
  @name(label='SA标识')
  id!!: string(30),

  @persistence(name='sa_type_cd')
  @name(label='SA类型')
  type: string(20),

  @persistence(name='sa_status_flg')
  @name(label='状态')
  status: enum[ACT:生效, STOP:终止, HOLD:暂停],

  @persistence(name='start_dt')
  start_date: date,

  @persistence(name='end_dt')
  end_date: date,

  @name(label='账户')
  account: &account(id),

  // 新增关联：服务协议属于哪个接入点
  @persistence(name='prem_id')
  @name(label='接入点')
  premise: &premise(id)
>

// ==========================================
// 计费实体：账单 (Bill)
// ==========================================
@persistence(name='ci_bill')
@name(label='账单', singular='bill', plural='bills')
bill<

  @persistence(name='bill_id')
  @name(label='账单标识')
  id!!: string(30),

  @persistence(name='bill_dt')
  @name(label='账单日期')
  bill_date: date,

  @persistence(name='due_dt')
  @name(label='到期日')
  due_date: date,

  @persistence(name='bill_status_flg')
  @name(label='账单状态')
  status: enum[PND:待处理, CMP:完成, CAN:作废],

  @persistence(name='tot_bill_amt')
  @name(label='账单总额')
  total_amount: number(15,2),

  @name(label='账户')
  account: &account(id),

  @name(label='账单分段')
  bill_segments: &bill_segment(bill)[]
>

@persistence(name='ci_bill_char')
@name(label='账单属性', singular='bill_attribute', plural='bill_attributes')
bill_attribute<

  // 【主键1】 + 【外键】：指向所属账单
  @persistence(name='bill_id')
  @name(label='账单')
  bill!!: &bill(id),

  // 【主键2】：属性类型
  @persistence(name='char_type_cd')
  @name(label='属性类型')
  type!!: string(8),

  // 账单属性通常是快照数据，记录生成账单时刻的值
  @persistence(name='char_val')
  @name(label='属性值')
  value: string(50),

  @persistence(name='adhoc_char_val')
  @name(label='自定义值')
  adhoc_value: string(254)
>

// ==========================================
// 计费实体：账单分段 (Bill Segment)
// ==========================================
@persistence(name='ci_bill_seg')
@name(label='账单分段', singular='bill_segment', plural='bill_segments')
bill_segment<

  @persistence(name='bill_seg_id')
  id!!: string(30),

  @persistence(name='sa_id')
  @name(label='服务协议')
  service_agreement: &service_agreement(id),

  @persistence(name='seg_status_flg')
  @name(label='分段状态')
  status: enum[PND:待算费, CMP:完成],

  @persistence(name='typ')
  type: string(20),

  @persistence(name='start_dt')
  start_date: date,

  @persistence(name='end_dt')
  end_date: date,

  @persistence(name='bill_amt')
  amount: number(15,2),

  @name(label='账单')
  bill: &bill(id)
>

// ==========================================
// 财务实体：财务交易 (Financial Transaction)
// ==========================================
@persistence(name='ci_ft')
@name(label='财务交易', singular='financial_transaction', plural='financial_transactions')
financial_transaction<

  @persistence(name='ft_id')
  id!!: string(30),

  @persistence(name='ft_type_flg')
  @name(label='交易类型')
  type: enum[
    BS:账单生成,
    PM:付款,
    ADJ:调整,
    XFER:转账
  ],

  @persistence(name='ft_type_id')
  @name(label='调整类型（标识）')
  ft_type_id: string(30),

  @persistence(name='ft_amt')
  amount: number(15,2),

  @persistence(name='ars_dt')
  accounting_date: date,

  @name(label='账单分段')
  bill_segment: &bill_segment(id)
>

// ==========================================
// 业务实体：调整 (Adjustment)
// ==========================================
@persistence(name='ci_adj')
@name(label='调整', singular='adjustment', plural='adjustments')
adjustment<

  @persistence(name='adj_id')
  @name(label='调整标识')
  id!!: string(30),

  @persistence(name='sa_id')
  @name(label='服务协议')
  service_agreement: &service_agreement(id),

  @persistence(name='adj_type_cd')
  @name(label='调整类型')
  type: string(20),

  @persistence(name='adj_status_flg')
  @name(label='状态')
  status: enum[
    PND:待生效,
    ACT:已生效,
    CAN:已取消
  ],

  @persistence(name='adj_amt')
  @name(label='调整金额')
  amount: number(15,2),

  @persistence(name='adj_reason_cd')
  @name(label='调整原因')
  reason_code: string(30),

  @persistence(name='ars_dt')
  @name(label='会计日期')
  accounting_date: date,

  @persistence(name='cre_dttm')
  @name(label='创建时间')
  created_time = now: datetime
>

// ==========================================
// 资产实体：表计设备 (Meter)
// ==========================================
@persistence(name='ci_meter')
@name(label='表计', singular='meter', plural='meters')
meter<

  @persistence(name='mtr_id')
  @name(label='表计标识')
  id!!: string(10),

  @persistence(name='badge_nbr')
  @name(label='表身号')
  badge_number: string(30),

  @persistence(name='mtr_type_cd')
  @name(label='表计类型')
  type: string(8),

  @persistence(name='mfg_cd')
  @name(label='厂商')
  manufacturer: string(12),

  @persistence(name='model_cd')
  @name(label='型号')
  model: string(8),

  @persistence(name='install_dt')
  @name(label='安装日期')
  install_date: date,

  // 表计安装在哪个接入点
  @persistence(name='prem_id')
  @name(label='接入点')
  premise: &premise(id),

  // 反向引用：该表计的历史读数
  @name(label='抄表记录')
  reads: &meter_read(meter)[]
>

// ==========================================
// 计量实体：抄表记录 (Meter Read)
// ==========================================
@persistence(name='ci_mr')
@name(label='抄表记录', singular='meter_read', plural='meter_reads')
meter_read<

  @persistence(name='mr_id')
  @name(label='抄表标识')
  id!!: string(15),

  // ===================================
  // 外键关联
  // ===================================
  @persistence(name='mtr_id')
  @name(label='表计')
  meter: &meter(id),

  // 冗余存储 premise_id，为了优化查询性能，方便 DSL 直接关联
  // 对应 DSL: #(service_agreement.premise)
  @persistence(name='prem_id')
  @name(label='接入点')
  premise: &premise(id),

  // ===================================
  // 核心数据 (用于计费)
  // ===================================

  // 对应 DSL: {meter_read: usage}
  @persistence(name='usage_qty')
  @name(label='期间用量')
  usage: number(15, 6),

  @persistence(name='reg_reading')
  @name(label='表示数')
  register_reading: number(15, 6),

  @persistence(name='uom_cd')
  @name(label='计量单位')
  uom: string(4), // 如: KWH, M3, GAL

  // ===================================
  // 状态与时间
  // ===================================

  // 对应 DSL: status = 'E' (E: Effective/Billable)
  @persistence(name='mr_status_flg')
  @name(label='状态')
  status: enum[
    PND:待审核,
    E:可计费,
    ERR:异常,
    BILLED:已出账
  ],

  @persistence(name='read_type_flg')
  @name(label='抄表类型')
  type: enum[
    REG:定期轮抄,
    VER:核实读数,
    EST:系统估算,
    CUST:客户自填
  ],

  @persistence(name='read_dttm')
  @name(label='抄表时间')
  read_time: datetime,

  @persistence(name='cre_dttm')
  created_time = now: datetime
>

// ==========================================
// 配置实体：费率配置 (Rate Configuration)
// ==========================================
@persistence(name='cfg_rate')
@name(label='费率配置', singular='cfg_rate', plural='cfg_rates')
cfg_rate<

  // 物理主键
  @persistence(name='rate_cfg_id')
  @name(label='配置标识')
  id!!: string(30),

  // ===================================
  // 查找键 (Lookup Keys)
  // ===================================

  // 对应 DSL: #(service_agreement.rate_type)
  // 这是关联 SA 的关键字段，比如 "RES-1" (居民一档), "COM-A" (商业A类)
  @persistence(name='rate_type_cd')
  @name(label='费率类型')
  rate_type: string(20),

  // 关键字段：生效日期
  // 费率是随时间变化的 (2023年是1.0元，2024年是1.2元)
  // 系统查询时通常使用逻辑：WHERE rate_type = ? AND eff_dt <= ? ORDER BY eff_dt DESC
  @persistence(name='eff_dt')
  @name(label='生效日期')
  effective_date: date,

  // 辅助匹配：计量单位 (匹配 meter_read.uom)
  // 确保不会用 "水费单价" 去乘 "电量"
  @persistence(name='uom_cd')
  @name(label='计量单位')
  uom: string(4),

  // ===================================
  // 核心数值
  // ===================================

  // 对应 DSL: {cfg_rate: rate}
  // 单价 (Price Per Unit)
  @persistence(name='unit_rate')
  @name(label='单价')
  rate: number(15, 6),

  // ===================================
  // 描述信息
  // ===================================

  @persistence(name='descr')
  @name(label='描述')
  description: string(100),

  @persistence(name='currency_cd')
  @name(label='币种')
  currency: string(3), // CNY, USD

  @persistence(name='cre_dttm')
  created_time = now: datetime
>

// ==========================================
// 新增：阶梯费率明细 (Step Definitions)
// ==========================================
@persistence(name='cfg_rate_step')
@name(label='费率阶梯', singular='rate_step', plural='rate_steps')
cfg_rate_step<

  @persistence(name='step_id')
  @name(label='阶梯标识')
  id!!: string(30),

  // 关联回主配置 (通过主键或业务键关联)
  // 在实际查询时，通常使用 rate_type + effective_date + uom 来定位
  @persistence(name='rate_cfg_id')
  @name(label='所属费率配置')
  rate_header: &cfg_rate(id),

  // ===================================
  // 阶梯定义
  // ===================================

  // 顺序号：1, 2, 3...
  @persistence(name='seq_no')
  @name(label='阶梯序号')
  sequence: integer,

  // 阶梯上限 (Upper Limit)
  // 例如：阶梯1上限100，阶梯2上限300。
  // 超过最后一个上限的部分，通常取最后一条记录计算。
  // 999999999 代表无穷大
  @persistence(name='step_high_limit')
  @name(label='阶梯上限')
  high_limit: number(15, 2),

  // ===================================
  // 价格
  // ===================================

  @persistence(name='unit_rate')
  @name(label='阶梯单价')
  rate: number(15, 6),

  // ===================================
  // 高级配置 (CC&B 风格)
  // ===================================

  // 是否按比例折算 (Proration)
  // 如果账单周期只有15天（正常是30天），上限100是否要变成50？
  @persistence(name='prorate_flg')
  @name(label='是否折算阈值')
  prorate: boolean,

  @persistence(name='cre_dttm')
  created_time = now: datetime
>